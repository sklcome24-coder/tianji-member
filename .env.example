# 複製為 .env 後填寫（此檔勿上傳）
NODE_ENV=production
BASE_URL=https://你的網域
SITE_NAME=經方自學會員
APP_SECRET=用 openssl rand -hex 32 產生
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=至少12碼強密碼

# 知識庫主機（原本 tianji 的 RAG 後端，含 /health /gemini /tianji）
KB_BACKEND_URL=https://kb.你的網域
KB_BACKEND_KEY=後端通行密語

# 每日 AI 額度與方案價格
FREE_DAILY_AI=3
PAID_DAILY_AI=60
PLAN_MONTH_PRICE=299
PLAN_YEAR_PRICE=2990

# 寄信（未設定時信件內容只印在伺服器日誌）
SMTP_URL=smtps://帳號:應用程式密碼@smtp.gmail.com:465
MAIL_FROM=經方自學會員 <noreply@你的網域>

# 綠界正式商店（未設定時使用綠界公開測試環境，不會真的扣款）
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_ENDPOINT=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
